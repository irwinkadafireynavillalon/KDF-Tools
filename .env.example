# ==============================================================================
# KDF-TOOLS / KDF-LUX · ENVIRONMENT TEMPLATE (.env.example)
# Renombra este archivo a .env y configura tus credenciales
# ==============================================================================

# GOOGLE AI STUDIO / GEMINI API KEY
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# CONFIGURACIÓN DE RED BLINDADA & PUERTOS
INTERNAL_RAW_HOST=127.0.0.1
INTERNAL_CORE_PORT=5000
INTERNAL_AI_PORT=4250

# MODO DE SEGURIDAD
BLOCK_DIRECT_LOCALHOST=true
MASKED_SERVER_SIGNATURE=KDF-Shield/2.0
